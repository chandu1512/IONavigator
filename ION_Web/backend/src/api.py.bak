@app.route('/api/user', methods=['POST', 'OPTIONS'])
@cross_origin(origin="*", supports_credentials=True)
def add_user():
    if request.method == 'OPTIONS':
        return '', 200
    email = request.json.get('email')
    if not email:
        return jsonify({'error': 'Email is required'}), 400
    user_id, message, status_code = mongodb_client.add_user(email)
    return jsonify({'user_id': user_id, 'message': message}), status_code


@app.route('/api/user_traces', methods=['POST', 'OPTIONS'])
@cross_origin(origin="*", supports_credentials=True)
def get_user_traces():
    if request.method == 'OPTIONS':
        return '', 200
    try:
        data = request.get_json(force=True) or {}
        user_id = data.get("user_id", "test-user")
        search_query = data.get("search", "").lower()
        page = int(data.get("page", 1))
        page_size = int(data.get("page_size", 10))

        # New: Get traces from MongoDB (returns list)
        traces = mongodb_client.get_user_traces(
            user_id, search_query, page, page_size)

        # For FE compatibility: if traces is not a list, force to []
        if not isinstance(traces, list):
            traces = []

        return jsonify(traces), 200
    except Exception as e:
        print(f"Error fetching traces: {str(e)}")
        return jsonify({"error": str(e)}), 500

